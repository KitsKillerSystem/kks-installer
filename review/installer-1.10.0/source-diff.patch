+                    self.assertEqual(rows[5], {"glyph": b"Scrap [glyph]", "text": b"Scrap [Steel]", "none": b"Scrap"}[junk])
+                    self.assertIn(b"0,25", rows[6])
+                    state = manager._read_state()
